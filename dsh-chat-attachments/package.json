{
  "name": "dsh-chat-attachments",
  "version": "0.1.0",
  "description": "A DSH composer paperclip: native image drafts plus arbitrary workspace file uploads for older DSH builds.",
  "license": "MIT",
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
